# Where the media tree and the service state live on the host.
# MEDIA_ROOT must hold movies/, tv/ and downloads/ on ONE filesystem: imports
# are hardlinks. It is mounted at this same absolute path inside the containers.
MEDIA_ROOT=/srv/media
DATA_ROOT=/srv/data

# Optional. A separate library for documentaries, inside MEDIA_ROOT so imports
# can hardlink. Leave empty to keep them in movies/.
DOCUMENTARIES_PATH=

# Prowlarr Settings -> General -> API Key. Generated on its first run, so bring
# Prowlarr up once before filling this in.
PROWLARR_API_KEY=

# Optional. Without it, `butaca add` needs --lang, and series and
# recommendations do not work. Free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# qBittorrent runs natively on the host, not in this stack. Override if it does
# not listen on the host's port 8080.
QBITTORRENT_URL=http://host.docker.internal:8080

PROWLARR_TAG=latest
BUTACA_TAG=local

PUID=1000
PGID=1000
TZ=Europe/Madrid
